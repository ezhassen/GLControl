    <ProjectReference Include="..\..\opentk\src\OpenTK.Windowing.Common\OpenTK.Windowing.Common.csproj" />
    <ProjectReference Include="..\..\opentk\src\OpenTK.Windowing.Desktop\OpenTK.Windowing.Desktop.csproj" />
    <ProjectReference Include="..\..\opentk\src\OpenTK.Windowing.GraphicsLibraryFramework\OpenTK.Windowing.GraphicsLibraryFramework.csproj" />
  </ItemGroup>-->

  <!--<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
